    "require": {
        "codemirror/codemirror": "^5.65",
        "composer/composer": "^2.8",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2@beta",
        "drupal/ai_agent_agent": "dev-1.0.x",
        "drupal/ai_provider_litellm": "@beta",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/core-composer-scaffold": "^11.2.4",
        "drupal/core-project-message": "^11.2.4",
        "drupal/core-recipe-unpack": "^11.2.4",
        "drupal/core-vendor-hardening": "^11.2.4",
        "drupal/drupal_cms_accessibility_tools": "^1.2",
        "drupal/drupal_cms_ai": "^1.2",
        "drupal/drupal_cms_blog": "^1.2",
        "drupal/drupal_cms_case_study": "^1.2",
        "drupal/drupal_cms_events": "^1.2",
        "drupal/drupal_cms_forms": "^1.2",
        "drupal/drupal_cms_google_analytics": "^1.2",
        "drupal/drupal_cms_news": "^1.2",
        "drupal/drupal_cms_page": "^1.2",
        "drupal/drupal_cms_person": "^1.2",
        "drupal/drupal_cms_project": "^1.2",
        "drupal/drupal_cms_seo_tools": "^1.2",
        "drupal/drupal_cms_starter": "^1.2",
        "drupal/flowdrop": "1.x-dev@dev",
        "drupal/flowdrop_ui_agents": "1.0.x-dev@dev",
        "drupal/mcp_client": "^1.0@alpha",
        "drupal/recipe_installer_kit": "^1-alpha6@alpha",
        "drupal/tool": "^1.0@alpha",
        "drupal/webform": "@beta",
        "jquery/inputmask": "^5.0",
        "jquery/intl-tel-input": "^17.0",
        "jquery/rateit": "^1.1",
        "jquery/select2": "^4.0",
        "jquery/textcounter": "^0.9.1",
        "jquery/timepicker": "^1.14",
        "popperjs/popperjs": "^2.11",
        "progress-tracker/progress-tracker": "^2.0",
        "signature_pad/signature_pad": "^2.3",
        "tabby/tabby": "^12.0",
        "tippyjs/tippyjs": "^6.3"
    },
    "require-dev": {
        "composer/installers": "^1 || ^2",
        "drupal/core-composer-scaffold": "^11",
        "cweagans/composer-patches": "~1.0",
        "drupal/core-recommended": "^11",
        "drupal/core-dev": "*",
        "php-parallel-lint/php-parallel-lint": "^1.2",
        "drush/drush": "^13.6.1",
        "mglaman/phpstan-drupal": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "*"
    },
    "conflict": {
        "phpunit/phpunit": ">=11.5.29 <11.5.31",
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 36000,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupalspoons/composer-plugin": true,
            "phpstan/extension-installer": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "drupal/core-vendor-hardening": true
        },
        "audit": {
            "ignore": {
                "PKSA-yhcn-xrg3-68b1": "Drupal9.5 twig v2.15.4 to v2.15.6",
                "PKSA-2wrf-1xmk-1pky": "Drupal9.5 twig v2.15.4 to v2.15.6",
                "PKSA-6319-ffpf-gx66": "Drupal9.5 twig v2.15.4 to v2.15.6",
                "PKSA-365x-2zjk-pt47": "Drupal 11.1 symfony/http-foundation >=2 <=7.3.7. CVE-2025-64500",
                "PKSA-1gck-s111-yq7g": "Drupal 11.1 older versions of Composer < 2.9.3"
            }
        },
        "bin-dir": "vendor/bin",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "installer-paths": {
            "web/core": [
                "type:drupal-core",
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module",
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile",
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme",
                "type:drupal-theme"
            ],
            "./drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "./recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "drush/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/default/settings.php": {
                    "path": "web/core/assets/scaffold/files/default.settings.php",
                    "overwrite": false
                },
                "[web-root]/example.gitignore": false
            }
        },
        "drush": {
            "services": {
                "drush.services.yml": "^9 || ^10 || ^11"
            }
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                   </>",
                "<bg=blue;fg=white>  Congratulations, you\u2019ve installed Drupal CMS!    </>",
                "<bg=blue;fg=white>                                                   </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://drupal.org/support",
                "  * Get involved with the Drupal community: https://drupal.org/getting-involved"
            ]
        },
        "drupal-core-vendor-hardening": {
            "composer/composer": false
        }
    },
    "version": "1.2.10",
    "homepage": "https://www.drupal.org/project/cms",
    "support": {
        "docs": "https://new.drupal.org/docs/drupal-cms",
        "chat": "https://drupal.org/node/314178"
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r \u0022@unlink(\u0027vendor/bin/composer\u0027);\u0022"
        ],
        "post-drupal-scaffold-cmd": "cd web/sites/default \u0026\u0026 test -z \u0022$(grep \u0027include \\$devpanel_settings;\u0027 settings.php)\u0022 \u0026\u0026 patch -Np1 -r /dev/null < $APP_ROOT/.devpanel/drupal-settings.patch || :"
    }
}